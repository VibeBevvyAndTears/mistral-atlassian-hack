# Project
PROJECT_NAME=fullstack-starter-api
PROJECT_ENV=local

# Database
DATABASE_URL=postgresql+asyncpg://postgres.[project]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/app

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Auth (better-auth web server)
BETTER_AUTH_URL=http://localhost:3000

# JWT/JWE (stateless authentication)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWE_SECRET_KEY=your-super-secret-jwe-encryption-key-change-in-production

# Redis (optional)
# REDIS_URL=redis://localhost:6379

# OpenTelemetry (optional - for production tracing & metrics)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=fullstack-starter-api

# OpenTelemetry GenAI (LLM observability - OTel GenAI semconv).
# Prompt/completion content is PII-sensitive: "off" records only metadata
# (model, token usage, latency). Set to span_only/event_only/span_and_event to
# capture message content. Auto-enables OTEL_SEMCONV_STABILITY_OPT_IN.
# OTEL_GENAI_CAPTURE_MESSAGE_CONTENT=off

# AI — Cross-Team uses Mistral (PRD §12.1)
AI_PROVIDER=mistral
GOOGLE_CLOUD_PROJECT=
GEMINI_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-large-latest
MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_KILL_SWITCH=false

# Storage (optional)
STORAGE_BACKEND=minio
GCS_BUCKET_NAME=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Supabase (optional)
SUPABASE_URL=https://[project].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Weaviate (optional)
WEAVIATE_URL=
WEAVIATE_API_KEY=

# Backblaze B2 (optional)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
